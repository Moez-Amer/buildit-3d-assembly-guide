# Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

CLAUDE_ASK_MODEL=claude-haiku-5-5
PORT=8787

CHECK_REPAIR=1
# Third pass: render the 3D model and let Claude compare it with the manual. Off by default; 1 = on.
# Needs Chrome: set RENDER_BROWSER to its path, or run: npx playwright-core install chromium
# RENDER_COMPARE=1
# RENDER_BROWSER=

# Read manuals with another model instead of Claude: any OpenAI-compatible API.
# Kimi (Moonshot):  SCAN_BASE_URL=https://api.moonshot.ai/v1     SCAN_MODEL=kimi-k3.1-pro
# OpenRouter:       SCAN_BASE_URL=https://openrouter.ai/api/v1   SCAN_MODEL=moonshotai/kimi-k3.1-pro
# SCAN_BASE_URL=
# SCAN_API_KEY=
# SCAN_MODEL=
# SCAN_REASONING=high   # optional thinking level (Kimi: low, high, max)
# SCAN_MAX_TOKENS=64000

# ---- Accounts (sign-in by email link) ----
# Your own email: admins may scan before payments exist and see guides made before accounts.
ADMIN_EMAILS=
# Who may scan their own manual: admins (default) or everyone signed in
# SCAN_ACCESS=admins
# The site's public address, used in sign-in emails. Required in production.
# APP_URL=https://buildit.example
# Outgoing email (any SMTP provider). Without it, in development the sign-in link is printed in the server log.
# SMTP_URL=smtps://user:password@smtp.example.com:465
# MAIL_FROM=Buildit <signin@buildit.example>
# Behind a reverse proxy, so rate limits see the visitor's address: TRUST_PROXY=1
# TRUST_PROXY=

# Supabase: backend only
SUPABASE_URL=
SUPABASE_SECRET_KEY=